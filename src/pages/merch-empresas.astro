---
// Landing "Merch para empresas". Diseño: diseno/EmpresasV1.dc.html (escritorio)
// y diseno/EmpresasMobileV1.dc.html (celular).
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import BotonCatalogo from '../components/merch/BotonCatalogo.astro';
import SelectorMerch, { type FotoOptimizada } from '../components/merch/SelectorMerch.tsx';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { CATEGORIAS } from '../data/merch';

// Fotos de categorías: se buscan por nombre en src/assets/merch/ y se
// convierten a WebP en 3 tamaños (el navegador elige el justo).
const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/merch/*.{jpg,jpeg,png,webp}', { eager: true });
async function optimizar(nombre: string, widths = [360, 700, 1000]): Promise<FotoOptimizada | null> {
  const original = archivos[`../assets/merch/${nombre}`]?.default;
  if (!original) {
    console.warn(`[merch] Falta la imagen src/assets/merch/${nombre}`);
    return null;
  }
  const img = await getImage({ src: original, widths, format: 'webp', quality: 80 });
  return { src: img.src, srcset: img.srcSet.attribute };
}
const principal = await optimizar('merch-principal.jpg', [640, 1024]);
const servicios = {
  vertical: await optimizar('merch-servicios-vertical.png', [700, 896]),
  horizontal: await optimizar('merch-servicios-horizontal.png', [720, 1424]),
};
const fotosCategorias: Record<string, FotoOptimizada[]> = {};
for (const c of CATEGORIAS) {
  fotosCategorias[c.id] = (await Promise.all(c.fotos.map((nombre) => optimizar(nombre)))).filter((f): f is FotoOptimizada => f !== null);
}

const confianza = [
  { texto: 'Te mostramos cómo quedará antes de fabricar', icono: 'escudo' },
  { texto: 'Almacén propio en Lima', icono: 'almacen' },
  { texto: 'Entregas en Lima y provincias', icono: 'camion' },
  { texto: 'Emitimos factura', icono: 'factura' },
];

const beneficios = [
  { titulo: 'Una sola cotización', texto: 'Todo tu merch en un solo pedido, sin comparar cinco proveedores.' },
  { titulo: 'Lo eliges desde tu oficina', texto: 'Sin ir al Centro a buscar ni perder la mañana en vueltas.' },
  { titulo: 'Una sola entrega, donde la necesites', texto: 'En tus sedes, tu evento o con tus colaboradores, en Lima y provincias.' },
  { titulo: 'Ves cómo quedará antes de fabricar', texto: 'Te mostramos tu producto con tu logo antes de producirlo.' },
  { titulo: 'Almacén propio en Lima', texto: 'Guardamos tu stock y lo retiras por partes, cuando lo necesites.' },
  { titulo: 'Emitimos factura', texto: 'Todo en regla para tu área de compras.' },
];
---

<Base
  titulo="Merch para empresas con tu logo · Laboratorio Digital"
  descripcion="Polos, tomatodos, peluches y más con el logo de tu empresa. Lo producimos, lo guardamos en nuestro almacén en Lima y lo entregamos en Lima y provincias."
  tema="claro"
  actual="empresas"
  imagenCompartir="/og/merch-empresas.jpg"
>
  <BotonCatalogo variante="cabecera" slot="acciones" />
  <BotonCatalogo variante="menu" slot="acciones-movil" />

  <main class="merch">
    <!-- Primera pantalla: portada + íconos de confianza (llenan la pantalla) -->
    <div class="primera-pantalla">
    <section class="hero">
      <div class="hero__texto">
        <h1>Merch para tu empresa, <br />producido y entregado.</h1>
        <p>
          <span class="solo-escritorio">Polos, tomatodos, peluches y más con tu logo.</span><span class="solo-movil">Con tu logo.</span> Lo fabricamos, lo guardamos y lo llevamos a donde lo necesites.
        </p>
        <BotonCatalogo variante="grande" />
        <a class="hero__elegir" href="#catalogo">O elige aquí lo que necesitas ↓</a>
      </div>
      <div class="hero__foto">
        <Foto
          src={principal?.src ?? null}
          srcset={principal?.srcset}
          sizes="(max-width: 1099px) 100vw, 636px"
          posicion="50% 78%"
          alt="Kit de merch corporativo: polo, taza, tomatodo, bolsa, peluche, credencial y pines con logo"
          etiqueta="FOTO PRINCIPAL · PRODUCTOS CON LOGO"
          fondo="#DDE9E3"
          prioridad
        />
      </div>
    </section>

    <!-- Confianza -->
    <ul class="confianza" aria-label="Por qué elegirnos">
      {
        confianza.map((c) => (
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="#141414" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {c.icono === 'escudo' && (
                <>
                  <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z" />
                  <path d="M8.5 12l2.5 2.5 4.5-5" />
                </>
              )}
              {c.icono === 'almacen' && (
                <>
                  <path d="M3 10l9-6 9 6v10H3z" />
                  <path d="M8 20v-6h8v6" />
                </>
              )}
              {c.icono === 'camion' && (
                <>
                  <rect x="2" y="7" width="12" height="9" rx="1" />
                  <path d="M14 10h4l3 3v3h-7" />
                  <circle cx="6.5" cy="18" r="1.8" />
                  <circle cx="17.5" cy="18" r="1.8" />
                </>
              )}
              {c.icono === 'factura' && (
                <>
                  <rect x="5" y="3" width="14" height="18" rx="2" />
                  <path d="M9 8h6M9 12h6M9 16h3" />
                </>
              )}
            </svg>
            <span>{c.texto}</span>
          </li>
        ))
      }
    </ul>
    </div>

    <!-- Catálogo + servicios + barra de celular (interactivo) -->
    <SelectorMerch client:load fotosCategorias={fotosCategorias} fotoServicios={servicios} />

    <!-- ¿Cansado de cotizar...? -->
    <section class="cansado" aria-labelledby="cansado">
      <div class="cansado__texto">
        <h2 id="cansado">¿Cansado de cotizar con un proveedor distinto para cada cosa?</h2>
        <p>Con nosotros pides todo en un solo lugar: lo producimos, lo guardamos y lo entregamos.</p>
      </div>
      <ul class="beneficios">
        {
          beneficios.map((b) => (
            <li>
              <span class="beneficios__check" aria-hidden="true">
                <svg viewBox="0 0 16 16" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 8.5l3.5 3.5L13 4.5" />
                </svg>
              </span>
              <span class="beneficios__texto">
                <strong>{b.titulo}</strong>
                <span>{b.texto}</span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Catálogo en PDF -->
    <section class="banda-pdf" aria-labelledby="banda-pdf">
      <div class="banda-pdf__texto">
        <h2 id="banda-pdf">¿Prefieres ver todo el detalle?</h2>
        <p>El catálogo tiene medidas, materiales y técnicas de cada producto.</p>
      </div>
      <BotonCatalogo variante="banda" />
    </section>
  </main>
</Base>

<style>
  .merch {
    width: 100%;
    max-width: var(--ancho-max);
    margin-inline: auto;
    padding: 56px clamp(16px, 2.3vw, 32px) 64px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .solo-movil {
    display: none;
  }

  /* La portada y los íconos ocupan al menos el alto visible, así el título
     "¿Qué necesitas producir?" aparece recién al bajar. */
  .primera-pantalla {
    min-height: calc(100svh - var(--cabecera-alto) - 56px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 48px;
  }

  /* ---------- Portada ---------- */
  .hero {
    padding: 0 24px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 56px;
    align-items: center;
  }
  .hero__texto {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero h1 {
    font-weight: 900;
    font-size: clamp(42px, 4vw, 57px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .hero p {
    max-width: 640px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--texto-suave);
    margin-bottom: 6px;
  }
  .hero__elegir {
    align-self: flex-start;
    min-height: 44px;
    display: flex;
    align-items: center;
    font-size: 17px;
    font-weight: 800;
    color: #141414;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .hero__elegir:hover {
    color: #0f7a44;
  }
  /* En escritorio el recuadro mantiene la proporción de la foto (8:7), para
     que en laptops angostas no se corten los productos de los costados. */
  .hero__foto {
    aspect-ratio: 8 / 7;
    max-height: 560px;
    border-radius: 22px;
    overflow: hidden;
  }

  /* ---------- Confianza ---------- */
  .confianza {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .confianza li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
    font-size: 17px;
    font-weight: 700;
    color: var(--texto-suave);
  }
  .confianza svg {
    width: 58px;
    height: 58px;
  }

  /* ---------- ¿Cansado...? ---------- */
  .cansado {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: 48px;
    align-items: center;
    padding: 48px;
    border-radius: 22px;
    background: var(--gris);
  }
  .cansado__texto {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cansado h2 {
    font-weight: 900;
    font-size: 42px;
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .cansado__texto p {
    font-size: 20px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--texto-suave);
  }
  .beneficios {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .beneficios li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 16px;
    border-radius: 14px;
    background: #ffffff;
  }
  .beneficios__check {
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #0f7a44;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .beneficios__check svg {
    width: 15px;
    height: 15px;
  }
  .beneficios__texto {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--texto-suave);
  }
  .beneficios__texto strong {
    font-size: 17px;
    font-weight: 800;
    line-height: 1.3;
    color: #141414;
  }

  /* ---------- Banda PDF ---------- */
  .banda-pdf {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    padding: 36px 44px;
    border-radius: 22px;
    background: #141414;
    color: #ffffff;
  }
  .banda-pdf__texto {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .banda-pdf h2 {
    font-weight: 800;
    font-size: 32px;
    line-height: 1.15;
  }
  .banda-pdf p {
    font-size: 18px;
    font-weight: 600;
    color: #d6d6d6;
  }

  /* Pantallas grandes (monitores altos al 100 %): la primera pantalla crece
     con el alto visible para no dejar vacío arriba y abajo. */
  @media (min-width: 1100px) {
    .merch {
      max-width: 1920px;
    }
    .hero h1 {
      font-size: clamp(42px, min(3.4vw, 6svh), 76px);
    }
    .hero p {
      max-width: 760px;
      font-size: clamp(20px, 2.1svh, 26px);
    }
    .hero__foto {
      max-height: clamp(560px, 60svh, 820px);
    }
    .confianza svg {
      width: clamp(58px, 6svh, 80px);
      height: clamp(58px, 6svh, 80px);
    }
    .confianza li {
      font-size: clamp(17px, 1.7svh, 21px);
    }
  }

  /* ---------- Tablet ---------- */
  @media (max-width: 1099px) {
    .hero {
      padding: 0;
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero__foto {
      aspect-ratio: auto;
      max-height: none;
      height: 520px;
    }
    .confianza {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 16px;
    }
    .cansado {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 36px 32px;
    }
    .cansado h2 {
      font-size: 34px;
    }
    .banda-pdf {
      flex-direction: column;
      align-items: flex-start;
      padding: 32px;
    }
  }

  /* ---------- Celular ---------- */
  @media (max-width: 767px) {
    .banda-pdf {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .primera-pantalla {
      min-height: 0;
      gap: 32px;
    }
    .merch {
      padding: 24px 16px 32px;
      gap: 32px;
    }
    .solo-escritorio {
      display: none;
    }
    .solo-movil {
      display: inline;
    }
    .hero {
      gap: 14px;
    }
    .hero__texto {
      gap: 14px;
    }
    .hero h1 {
      font-size: 38px;
      line-height: 1;
      letter-spacing: -0.02em;
    }
    .hero h1 br {
      display: none;
    }
    .hero p {
      font-size: 17px;
      margin-bottom: 0;
    }
    .hero__elegir {
      display: none;
    }
    .hero__foto {
      margin-top: 14px;
      aspect-ratio: auto;
      height: 250px;
      border-radius: 18px;
    }
    .confianza {
      gap: 18px 12px;
    }
    .confianza li {
      font-size: 14px;
    }
    .confianza svg {
      width: 40px;
      height: 40px;
    }
    .cansado {
      padding: 22px 16px;
      border-radius: 18px;
      gap: 14px;
    }
    .cansado__texto {
      gap: 10px;
    }
    .cansado h2 {
      font-size: 26px;
      line-height: 1.1;
      letter-spacing: -0.01em;
    }
    .cansado__texto p {
      font-size: 15px;
    }
    .beneficios {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .beneficios li {
      padding: 12px 14px;
    }
    .beneficios__check {
      width: 26px;
      height: 26px;
    }
    .beneficios__check svg {
      width: 13px;
      height: 13px;
    }
    .beneficios__texto {
      font-size: 13px;
    }
    .beneficios__texto strong {
      font-size: 15px;
    }
  }
</style>
