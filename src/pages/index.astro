---
// Portada: logo (en la cabecera), una frase y las 3 opciones.
import Base from '../layouts/Base.astro';
import IconoWhatsApp from '../components/IconoWhatsApp.astro';
import { paginas, sitio } from '../data/sitio';
import { enlaceWhatsApp } from '../lib/whatsapp';

const ruta = Object.fromEntries(paginas.map((p) => [p.id, p.ruta]));

// Ficha de la empresa para Google (schema.org). Solo datos que ya son
// públicos en el sitio. Las redes se agregan solas cuando tengan URL.
const web = Astro.site?.href ?? Astro.url.origin + '/';
const empresa = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': web + '#empresa',
  name: sitio.marca,
  legalName: sitio.razonSocial,
  taxID: sitio.ruc,
  description: sitio.descripcion,
  url: web,
  logo: new URL('/logo.png', web).href,
  image: new URL('/og/inicio.jpg', web).href,
  telephone: '+' + sitio.whatsapp.numero,
  email: sitio.correo ?? undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: sitio.direccion.calle,
    addressLocality: sitio.direccion.distrito,
    addressRegion: sitio.direccion.ciudad,
    addressCountry: sitio.direccion.pais,
  },
  areaServed: { '@type': 'Country', name: 'Perú' },
  sameAs: sitio.redes.flatMap((r) => (r.url ? [r.url] : [])),
};
---

<Base
  titulo="Laboratorio Digital · Diseño, marketing, video y merch en Lima"
  descripcion="Diseño, marketing, video y merchandising para empresas, marcas y creadores. Elige por dónde empezar y escríbenos por WhatsApp."
  tema="claro"
  actual="inicio"
  datosEstructurados={empresa}
>
  <main class="portada contenedor">
    <section class="intro">
      <h1>Todo para tu marca, en un solo lugar.</h1>
      <p>
        Diseño, marketing, video y merchandising en Lima. Elige por dónde empezar o
        <a class="intro__wa" href={enlaceWhatsApp()}><IconoWhatsApp tamano={20} />escríbenos por WhatsApp</a>.
      </p>
    </section>

    <ul class="tarjetas" aria-label="Nuestros servicios">
      <li class="tarjeta tarjeta--estudio">
        <div class="tarjeta__ilustracion" aria-hidden="true">
          <svg viewBox="0 0 240 160" width="240" height="160">
            <g transform="rotate(-12 82 136)">
              <rect x="44" y="30" width="76" height="106" rx="10" fill="#FF5A36" stroke="#0B0E33" stroke-width="3"></rect>
              <rect x="51" y="37" width="62" height="92" rx="6" fill="#FFE4D9"></rect>
              <path transform="translate(66 67) scale(1.6)" d="M10 1c3 4 6 6.5 6 11a6 6 0 0 1-12 0c0-2.5 1.2-4 2.6-5.4.3 1.8 1.2 2.8 2.4 3.2C8.4 6.8 8.6 4 10 1z" fill="#8A2208"></path>
            </g>
            <g transform="rotate(12 158 136)">
              <rect x="120" y="30" width="76" height="106" rx="10" fill="#8B5CF6" stroke="#0B0E33" stroke-width="3"></rect>
              <rect x="127" y="37" width="62" height="92" rx="6" fill="#ECE4FF"></rect>
              <path transform="translate(142 67) scale(1.6)" d="M6 3.5v13l11-6.5z" fill="#3B1782"></path>
            </g>
            <g>
              <rect x="82" y="16" width="76" height="106" rx="10" fill="#FFC928" stroke="#0B0E33" stroke-width="3"></rect>
              <rect x="89" y="23" width="62" height="92" rx="6" fill="#FFF3C4"></rect>
              <path transform="translate(104 53) scale(1.6)" d="M11.5 1 3 11.5h5.5L7.5 19 17 7.5h-5.8z" fill="#7A4E00"></path>
            </g>
          </svg>
        </div>
        <span class="tarjeta__etiqueta">DISEÑO · MARKETING · AUDIOVISUAL</span>
        <h2><a href={ruta.estudio}>Diseño, marketing y video</a></h2>
        <p>Elige módulos, arma tu mazo y mira al instante una inversión referencial.</p>
        <span class="tarjeta__cta" aria-hidden="true">Arma tu mazo <span>→</span></span>
      </li>

      <li class="tarjeta tarjeta--empresas">
        <div class="tarjeta__ilustracion" aria-hidden="true">
          <svg viewBox="0 0 240 160" width="240" height="160">
            <rect x="150" y="44" width="62" height="46" rx="3" fill="#E0A96D" stroke="#141414" stroke-width="3"></rect>
            <path d="M172 44v14h18V44" fill="#FFFFFF" stroke="#141414" stroke-width="3"></path>
            <path d="M40 60l22-14h16q6 10 18 10t18-10h16l22 14-12 22-14-8v82H64V74l-14 8z" fill="#FFFFFF" stroke="#141414" stroke-width="3" stroke-linejoin="round"></path>
            <path d="M80 46q5 12 16 12t16-12" stroke="#141414" stroke-width="3" fill="none"></path>
            <circle cx="96" cy="100" r="15" fill="#FFC21A" stroke="#141414" stroke-width="3"></circle>
            <rect x="160" y="100" width="42" height="50" rx="6" fill="#FFFFFF" stroke="#141414" stroke-width="3"></rect>
            <path d="M202 110h7a10 10 0 0 1 0 20h-7" fill="none" stroke="#141414" stroke-width="3"></path>
            <circle cx="181" cy="124" r="9" fill="#128C4A"></circle>
            <path d="M14 157h212" stroke="#141414" stroke-width="3" stroke-linecap="round" opacity=".25"></path>
          </svg>
        </div>
        <span class="tarjeta__etiqueta">PARA EMPRESAS</span>
        <h2><a href={ruta.empresas}>Merch para empresas</a></h2>
        <p>Polos, tomatodos, peluches y más con tu logo. Lo producimos, lo guardamos y lo entregamos.</p>
        <span class="tarjeta__cta" aria-hidden="true">Elige tus productos <span>→</span></span>
      </li>

      <li class="tarjeta tarjeta--marca">
        <div class="tarjeta__ilustracion" aria-hidden="true">
          <svg viewBox="0 0 240 170" width="240" height="170">
            <rect x="150" y="26" width="64" height="80" rx="4" fill="#FFFFFF" stroke="#D9B98A" stroke-width="3"></rect>
            <path d="M164 78c4-18 14-26 20-26s14 6 16 24" stroke="#B9A6F5" stroke-width="3" fill="none" stroke-linecap="round" stroke-dasharray="5 5"></path>
            <path d="M170 92h30" stroke="#D9B98A" stroke-width="3" stroke-linecap="round"></path>
            <ellipse cx="96" cy="118" rx="52" ry="40" fill="#B9A6F5"></ellipse>
            <ellipse cx="62" cy="76" rx="13" ry="17" fill="#B9A6F5"></ellipse>
            <ellipse cx="130" cy="76" rx="13" ry="17" fill="#B9A6F5"></ellipse>
            <ellipse cx="62" cy="78" rx="6" ry="9" fill="#FFD6E8"></ellipse>
            <ellipse cx="130" cy="78" rx="6" ry="9" fill="#FFD6E8"></ellipse>
            <circle cx="80" cy="110" r="6" fill="#141414"></circle>
            <circle cx="112" cy="110" r="6" fill="#141414"></circle>
            <circle cx="82" cy="108" r="2" fill="#FFFFFF"></circle>
            <circle cx="114" cy="108" r="2" fill="#FFFFFF"></circle>
            <path d="M88 124q8 7 16 0" stroke="#141414" stroke-width="3" fill="none" stroke-linecap="round"></path>
            <circle cx="70" cy="126" r="6" fill="#FF9EC4" opacity=".7"></circle>
            <circle cx="122" cy="126" r="6" fill="#FF9EC4" opacity=".7"></circle>
            <path d="M36 40l4 9 9 4-9 4-4 9-4-9-9-4 9-4z" fill="#FF6B4A"></path>
            <path d="M140 30l3 6 6 3-6 3-3 6-3-6-6-3 6-3z" fill="#1FB5A5"></path>
          </svg>
        </div>
        <span class="tarjeta__etiqueta">PARA CREADORES Y ARTISTAS</span>
        <h2><a href={ruta.marca}>Crea tu marca</a></h2>
        <p>Ropa, accesorios y peluches con tu diseño o tus personajes. Nosotros los hacemos realidad.</p>
        <span class="tarjeta__cta" aria-hidden="true">Crea tu marca <span>→</span></span>
      </li>
    </ul>
  </main>
</Base>

<style>
  /* La portada llena la pantalla entre la cabecera y el pie: en pantallas
     altas las tarjetas crecen (hasta un tope) en vez de dejar espacio vacío;
     en pantallas de ~850 px de alto visible todo entra sin bajar. */
  .portada {
    flex: 1 0 auto;
    max-width: 1680px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: clamp(16px, 3vh, 56px);
  }

  .intro {
    padding: clamp(20px, 4vh, 64px) 0 clamp(16px, 3vh, 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(8px, 1.4vh, 14px);
    text-align: center;
  }
  .intro h1 {
    font-weight: 900;
    font-size: clamp(34px, min(4vw, 5.6vh), 64px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .intro p {
    max-width: 820px;
    font-size: clamp(17px, 2.2vh, 21px);
    font-weight: 600;
    line-height: 1.45;
    color: var(--texto-suave);
  }

  .intro__wa {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    vertical-align: bottom;
    color: #0f7a44;
    font-weight: 900;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .intro__wa :global(svg) {
    flex-shrink: 0;
  }
  .intro__wa:hover {
    color: #0a5c33;
  }

  /* ---------- Tarjetas ---------- */
  .tarjetas {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 1.6vw, 36px);
    flex: 1 1 auto;
    max-height: 680px;
  }

  .tarjeta {
    position: relative;
    padding: clamp(20px, 2.6vh, 28px);
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    gap: clamp(8px, 1.1vh, 12px);
    transition:
      transform 0.2s,
      box-shadow 0.2s;
  }
  .tarjeta:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 36px -22px rgba(0, 0, 0, 0.5);
  }
  .tarjeta:focus-within {
    outline: 3px solid var(--foco);
    outline-offset: 4px;
  }

  /* El dibujo toma el alto que sobre en la tarjeta. */
  .tarjeta__ilustracion {
    flex: 1 1 auto;
    min-height: clamp(72px, 12vh, 190px);
    max-height: 300px;
    margin-bottom: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* El SVG no define el alto: se ajusta (sin deformarse) al espacio del contenedor. */
  .tarjeta__ilustracion {
    position: relative;
  }
  .tarjeta__ilustracion svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .tarjeta__etiqueta {
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.1em;
  }

  .tarjeta h2 {
    font-weight: 900;
    font-size: clamp(26px, min(3.4vh, 2.2vw), 40px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .tarjeta h2 a {
    color: inherit;
    text-decoration: none;
  }
  /* Toda la tarjeta es clicable, pero el enlace real es el título. */
  .tarjeta h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .tarjeta h2 a:focus-visible {
    outline: none;
  }

  .tarjeta p {
    font-size: clamp(16px, 0.95vw, 18px);
    font-weight: 600;
    line-height: 1.45;
  }

  .tarjeta__cta {
    margin-top: auto;
    align-self: flex-start;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 800;
  }
  .tarjeta__cta span {
    transition: transform 0.2s;
  }
  .tarjeta:hover .tarjeta__cta span {
    transform: translateX(4px);
  }

  .tarjeta--estudio {
    background-color: #14184a;
    background-image:
      radial-gradient(rgba(255, 255, 255, 0.08) 1.5px, transparent 1.5px),
      radial-gradient(circle at 20% 0%, rgba(139, 92, 246, 0.4), transparent 55%),
      radial-gradient(circle at 100% 60%, rgba(255, 90, 54, 0.25), transparent 45%);
    background-size: 22px 22px, 100% 100%, 100% 100%;
    color: #fff8e7;
  }
  .tarjeta--estudio .tarjeta__etiqueta {
    color: #ffc928;
  }
  .tarjeta--estudio p {
    color: #d6d9ff;
  }
  .tarjeta--estudio .tarjeta__cta {
    background: #ffc928;
    color: #0b0e33;
    border: 3px solid #0b0e33;
    box-shadow: 0 4px 0 #0b0e33;
  }

  .tarjeta--empresas {
    background: #cfe4da;
  }
  .tarjeta--empresas .tarjeta__etiqueta {
    color: #0b5e34;
  }

  .tarjeta--marca {
    background: #ffe7c2;
  }
  .tarjeta--marca .tarjeta__etiqueta {
    color: #b2391f;
  }

  .tarjeta--empresas p,
  .tarjeta--marca p {
    color: #2a2a2a;
  }
  .tarjeta--empresas .tarjeta__cta,
  .tarjeta--marca .tarjeta__cta {
    background: #141414;
    color: #ffffff;
  }


  /* ---------- Tablet y celular ---------- */
  @media (max-width: 1099px) {
    .tarjetas {
      grid-template-columns: 1fr;
      max-width: 640px;
      margin-inline: auto;
      gap: 20px;
      flex: none;
      max-height: none;
    }
    .tarjeta__ilustracion {
      flex: none;
      height: 170px;
      min-height: 0;
    }
  }

  @media (max-width: 639px) {
    .intro {
      padding: 32px 0 28px;
      gap: 12px;
    }
    .intro h1 {
      font-size: 36px;
      letter-spacing: -0.02em;
    }
    .intro p {
      font-size: 17px;
    }

    .tarjeta {
      padding: 20px;
      border-radius: 20px;
      gap: 10px;
    }
    .tarjeta__ilustracion {
      height: 140px;
      margin-bottom: 4px;
    }
    .tarjeta__etiqueta {
      font-size: 11px;
    }
    .tarjeta h2 {
      font-size: 26px;
    }
    .tarjeta p {
      font-size: 15px;
    }
    .tarjeta__cta {
      margin-top: 8px;
      min-height: 48px;
      font-size: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tarjeta:hover {
      transform: none;
    }
    .tarjeta:hover .tarjeta__cta span {
      transform: none;
    }
  }
</style>
