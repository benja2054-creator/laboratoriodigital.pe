---
// Landing "Crea tu marca". Diseño: diseno/CreaMarcaV1.dc.html (escritorio)
// y diseno/CreaMarcaMobileV1.dc.html (celular).
import Base from '../layouts/Base.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import Destello from '../components/Destello.astro';
import Foto from '../components/Foto.astro';
import Ilustracion from '../components/crea-marca/Ilustracion.astro';
import TituloBurbuja from '../components/crea-marca/TituloBurbuja.astro';
import { BANDA_CLIENTES, MOSTRAR_BANDA_CLIENTES, PREGUNTAS, PRODUCTOS, SERVICIOS_MARCA } from '../data/crea-marca';
import { enlaceWhatsApp, MENSAJE_CREA_MARCA } from '../lib/whatsapp';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Fotos de productos: se buscan por nombre en src/assets/marca/ y se
// convierten a WebP en 3 tamaños (el navegador elige el justo).
const archivos = import.meta.glob<{ default: ImageMetadata }>('../assets/marca/*.{jpg,jpeg,png,webp}', { eager: true });
async function optimizar(nombre: string | null, widths = [360, 640, 900]) {
  if (!nombre) return null;
  const original = archivos[`../assets/marca/${nombre}`]?.default;
  if (!original) {
    console.warn(`[marca] Falta la imagen src/assets/marca/${nombre}`);
    return null;
  }
  const img = await getImage({ src: original, widths, format: 'webp', quality: 80 });
  return { src: img.src, srcset: img.srcSet.attribute };
}
const principal = await optimizar('marca-principal.jpg', [640, 1000, 1400]);
const fotosProductos = await Promise.all(PRODUCTOS.map((p) => optimizar(p.foto)));
const fotosAnchas = await Promise.all(PRODUCTOS.map((p) => optimizar(p.fotoAncha ?? null)));

const wa = enlaceWhatsApp(MENSAJE_CREA_MARCA);
---

<Base
  titulo="Crea tu propia marca de productos · Laboratorio Digital"
  descripcion="Ropa, accesorios y peluches con tu diseño o tus personajes. Diseñamos, producimos, guardamos tu stock y enviamos a tus clientes en Lima y provincias."
  tema="claro"
  actual="marca"
  acento="#FF6B4A"
  imagenCompartir="/og/crea-tu-marca.jpg"
>
  <main>
    <!-- Portada -->
    <section class="hero">
      <Destello color="#1FB5A5" tamano={22} x="30px" y="500px" soloEscritorio />
      <div class="contenedor hero__grid">
        <div class="hero__texto">
          <Destello color="#FF6B4A" tamano={34} x="min(504px, calc(100% - 34px))" y="60px" xMovil="calc(100% - 34px)" yMovil="20px" />
          <span class="hero__etiqueta">PARA CREADORES, ARTISTAS Y COMUNIDADES</span>
          <h1>Crea tu propia marca <br />de productos.</h1>
          <p>Ropa, accesorios y peluches con tu diseño o tus personajes. Nosotros los hacemos realidad.</p>
          <div class="solo-sin-barra">
            <BotonWhatsApp href={wa} tamano="grande">Cuéntanos tu idea por WhatsApp</BotonWhatsApp>
          </div>
        </div>
        <div class="hero__foto">
          <Foto
            src={principal?.src ?? null}
            srcset={principal?.srcset}
            sizes="(max-width: 1099px) 100vw, 640px"
            posicion="50% 40%"
            alt="Creador con su polera estampada en un taller de serigrafía, con más poleras en producción"
            etiqueta="FOTO PRINCIPAL · CREADORES CON SU MERCH"
            fondo="#F3D2A2"
            prioridad
          />
        </div>
      </div>
    </section>

    <!-- Preguntas (sin título visible; el cierre "¿Respondiste 'sí' a alguna?" las retoma) -->
    <section class="seccion preguntas" aria-label="¿Te identificas con alguna?">
      <div class="contenedor preguntas__contenido">
        <ul class="preguntas__lista">
          {
            PREGUNTAS.map((p) => (
              <li>
                <div class="preguntas__dibujo">
                  <Ilustracion id={p.ilustracion} />
                </div>
                <p>{p.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Cierre -->
    <section class="cierre-marco contenedor" aria-labelledby="cierre">
      <div class="cierre">
        <Destello color="#FFC21A" tamano={36} x="-14px" y="-14px" xMovil="-10px" yMovil="-10px" />
        <div class="cierre__texto">
          <h2 id="cierre">¿Respondiste “sí” a alguna?</h2>
          <p>Escríbenos y te explicamos todo por WhatsApp, paso a paso y sin compromiso.</p>
        </div>
        <div class="solo-sin-barra">
          <BotonWhatsApp href={wa} tamano="grande" />
        </div>
      </div>
    </section>

    <!-- ¿Qué puedes crear? -->
    <section class="seccion" aria-labelledby="crear">
      <Destello color="#B9A6F5" tamano={30} x="32.6%" y="80px" xMovil="calc(100% - 70px)" yMovil="40px" />
      <div class="contenedor seccion__contenido">
        <div class="seccion__cabeza">
          <TituloBurbuja id="crear">¿Qué puedes crear?</TituloBurbuja>
          <p>Algunos de los productos que más piden los creadores. ¿Tienes otra idea? También la hacemos.</p>
        </div>
        <ul class="productos">
          {
            PRODUCTOS.map((p, i) => (
              <li class="producto">
                <div class="producto__foto">
                  <Foto
                    src={fotosProductos[i]?.src ?? null}
                    srcset={fotosProductos[i]?.srcset}
                    srcsetAncho={fotosAnchas[i]?.srcset}
                    sizes="(max-width: 1099px) 46vw, 421px"
                    alt={p.nombre}
                    etiqueta={`FOTO · ${p.nombre.toUpperCase()}`}
                  />
                </div>
                <div class="producto__texto">
                  <h3>
                    <span>{p.nombre}</span>
                  </h3>
                  <span class="producto__etiqueta">CARACTERÍSTICAS</span>
                  <ul>
                    {p.caracteristicas.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ¿Qué hacemos por ti? -->
    <section class="seccion" aria-labelledby="hacemos">
      <Destello color="#1FB5A5" tamano={30} x="36%" y="80px" xMovil="calc(100% - 70px)" yMovil="40px" />
      <div class="contenedor seccion__contenido">
        <div class="seccion__cabeza">
          <TituloBurbuja id="hacemos">¿Qué hacemos por ti?</TituloBurbuja>
          <p>Tú te enfocas en crear y en tu comunidad. Nosotros nos encargamos del resto.</p>
        </div>
        <ul class="servicios">
          {
            SERVICIOS_MARCA.map((s) => (
              <li class="servicio" style={`background: ${s.fondo}`}>
                <h3>{s.titulo}</h3>
                <div class="servicio__dibujo">
                  <Ilustracion id={s.id} />
                </div>
                <p>{s.texto}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Banda de productos de clientes (oculta por ahora: ver MOSTRAR_BANDA_CLIENTES) -->
    {
      MOSTRAR_BANDA_CLIENTES && (
    <section class="banda" aria-labelledby="banda-titulo">
      <div class="contenedor banda__cabeza">
        <h2 id="banda-titulo">ALGUNOS PRODUCTOS QUE YA HICIMOS PARA CREADORES</h2>
      </div>
      <div class="banda__marco" data-banda>
        <ul class="banda__pista">
          {
            [0, 1].map((copia) =>
              BANDA_CLIENTES.map((item) => (
                <li class="banda__item" aria-hidden={copia === 1 ? 'true' : undefined}>
                  <Foto src={item.foto} alt={item.titulo} etiqueta="" fondo={item.fondo} />
                  <span class="banda__nombre">{item.titulo}</span>
                </li>
              )),
            )
          }
        </ul>
      </div>
    </section>
      )
    }

  </main>

  <!-- Celular: botón de WhatsApp fijo abajo -->
  <div class="barra-wa">
    <BotonWhatsApp href={wa} />
  </div>
</Base>


<style>
  main {
    overflow-x: clip; /* los destellos pueden asomar por los bordes */
    padding-bottom: 80px;
  }

  /* ---------- Portada ---------- */
  /* La foto sobresale 48 px por debajo de la franja crema, como en el diseño. */
  .hero {
    position: relative;
    padding-bottom: 8px;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0 0 56px;
    background: #ffe7c2;
  }
  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(420px, 1fr) minmax(0, 640px);
    gap: 56px;
    align-items: start;
  }
  .hero__texto {
    position: relative;
    padding-top: 96px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .hero__etiqueta {
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 0.1em;
    color: #b2391f;
  }
  .hero h1 {
    font-weight: 900;
    font-size: clamp(40px, 3.9vw, 56px);
    line-height: 1.04;
    letter-spacing: -0.03em;
  }
  .hero__texto p {
    max-width: 540px;
    font-size: 22px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--texto-suave);
  }
  .hero__texto .solo-sin-barra {
    margin-top: 8px;
  }
  .hero__foto {
    margin-top: 48px;
    height: 560px;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 24px 48px -24px rgba(0, 0, 0, 0.35);
  }

  /* ---------- Secciones ---------- */
  .seccion {
    position: relative;
    padding-top: 80px;
  }
  .seccion__contenido {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  .seccion__cabeza {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
  }
  .seccion__cabeza p {
    max-width: 460px;
    font-size: 18px;
    font-weight: 600;
    line-height: 1.45;
    color: #555;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------- Preguntas ---------- */
  /* Compacta: ocupa el lugar del antiguo título "¿Te identificas con alguna?". */
  .preguntas {
    padding-top: 40px;
  }
  .preguntas__lista {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }
  .preguntas__lista li {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .preguntas__dibujo {
    height: 120px;
  }
  .preguntas__lista p {
    padding: 0 8px;
    font-size: 18px;
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  /* ---------- Productos ---------- */
  .productos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 44px 32px;
  }
  .producto {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .producto__foto {
    height: 280px;
    border-radius: 22px;
    overflow: hidden;
  }
  .producto__texto {
    padding: 0 6px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .producto h3 {
    font-weight: 900;
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  /* Resaltado amarillo detrás del nombre (no cursiva ni sombra). */
  .producto h3 span {
    padding: 0 2px;
    background: linear-gradient(transparent 58%, #ffe08a 58%, #ffe08a 92%, transparent 92%);
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .producto__etiqueta {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: #6b6b67;
  }
  .producto ul {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 16px;
    font-weight: 600;
    color: var(--texto-suave);
  }

  /* ---------- Servicios ---------- */
  .servicios {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .servicio {
    border-radius: 22px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .servicio h3 {
    align-self: flex-start;
    background: #141414;
    color: #ffffff;
    border-radius: 12px;
    padding: 7px 12px;
    font-size: 16px;
    font-weight: 800;
    line-height: 1.3;
  }
  .servicio__dibujo {
    height: 150px;
    padding: 0 30px;
  }
  .servicio p {
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
    color: #2a2a2a;
  }

  /* ---------- Banda ---------- */
  .banda {
    padding-top: 48px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .banda__cabeza {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .banda h2 {
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #6b6b6b;
  }

  .banda__marco {
    overflow: hidden;
  }
  .banda__pista {
    display: flex;
    width: max-content;
    animation: banda-desliza 45s linear infinite;
  }
  .banda__marco:hover .banda__pista,
  .banda__marco:focus-within .banda__pista {
    animation-play-state: paused;
  }
  @keyframes banda-desliza {
    to {
      transform: translateX(-50%);
    }
  }
  .banda__item {
    position: relative;
    width: 300px;
    height: 300px;
    margin-right: 20px;
    flex-shrink: 0;
    border-radius: 18px;
    overflow: hidden;
  }
  .banda__nombre {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: #ffffff;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 14px;
    font-weight: 800;
  }

  /* Sin movimiento: la banda queda quieta y se puede desplazar a mano. */
  @media (prefers-reduced-motion: reduce) {
    .banda__marco {
      overflow-x: auto;
      padding-inline: var(--margen);
    }
    .banda__pista {
      animation: none;
    }
    .banda__item[aria-hidden='true'] {
      display: none;
    }
  }

  /* ---------- Cierre ---------- */
  .cierre-marco {
    margin-block: 80px 0;
  }
  /* Menos aire entre el cierre negro y "¿Qué puedes crear?". */
  .cierre-marco + .seccion {
    padding-top: 48px;
  }
  .cierre {
    position: relative;
    padding: 56px 64px;
    border-radius: 28px;
    background: #141414;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 48px;
  }
  .cierre__texto {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .cierre h2 {
    font-weight: 900;
    font-size: 40px;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .cierre p {
    max-width: 620px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.45;
    color: #d0d0d0;
  }
  .cierre .solo-sin-barra {
    flex-shrink: 0;
  }

  /* ---------- Barra fija de celular ---------- */
  .barra-wa {
    display: none;
  }

  /* ---------- Laptop chica y tablet ---------- */
  @media (max-width: 1299px) {
    .hero h1 br {
      display: none;
    }
  }

  @media (max-width: 1099px) {
    .hero::before {
      inset: 0 0 120px;
    }
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .hero__texto {
      padding-top: 56px;
    }
    .hero__foto {
      margin-top: 0;
      height: 420px;
    }
    .preguntas__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 32px;
    }
    .preguntas__lista p {
      font-size: 17px;
    }
    .seccion__cabeza {
      flex-direction: column;
      align-items: flex-start;
      gap: 32px;
    }
    .productos,
    .servicios {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .cierre {
      padding: 40px;
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
    }
    .cierre h2 {
      font-size: 34px;
    }
  }

  /* ---------- Celular ---------- */
  @media (max-width: 767px) {
    .solo-sin-barra {
      display: none;
    }
    .barra-wa {
      display: block;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 20;
      padding: 12px 16px calc(20px + env(safe-area-inset-bottom));
      background: #ffffff;
      border-top: 1px solid var(--linea);
    }
    .barra-wa :global(.boton-wa) {
      width: 100%;
    }
    /* Espacio para que la barra fija no tape el final del pie. */
    :global(body) {
      padding-bottom: calc(96px + env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 639px) {
    .hero {
      padding-bottom: 0;
    }
    .hero::before {
      inset: 0;
    }
    .hero__grid {
      gap: 20px;
      padding-bottom: 24px;
    }
    .hero__texto {
      padding-top: 28px;
      gap: 14px;
    }
    .hero__etiqueta {
      font-size: 11px;
    }
    .hero h1 {
      font-size: 38px;
      line-height: 1.02;
      letter-spacing: -0.02em;
    }
    .hero__texto p {
      font-size: 17px;
    }
    .hero__foto {
      height: 230px;
      border-radius: 18px;
      box-shadow: none;
    }

    .seccion {
      padding-top: 44px;
    }
    .seccion__contenido {
      gap: 22px;
    }
    .seccion__cabeza {
      gap: 22px;
    }
    .seccion__cabeza p {
      font-size: 15px;
    }

    .preguntas {
      padding-top: 28px;
    }
    .preguntas__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 14px;
    }
    .preguntas__lista li {
      gap: 6px;
    }
    .preguntas__dibujo {
      height: 84px;
    }
    .preguntas__lista p {
      padding: 0;
      font-size: 15px;
      letter-spacing: 0;
    }

    .productos {
      gap: 24px 12px;
    }
    .producto {
      gap: 10px;
    }
    .producto__foto {
      height: 150px;
      border-radius: 16px;
    }
    .producto__texto {
      padding: 0;
      gap: 6px;
    }
    .producto h3 {
      font-size: 19px;
    }
    .producto__etiqueta {
      font-size: 11px;
    }
    .producto ul {
      gap: 2px;
      font-size: 13px;
      line-height: 1.35;
    }

    .servicios {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .servicio {
      border-radius: 18px;
      padding: 14px;
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 14px;
      row-gap: 6px;
      align-items: center;
    }
    .servicio h3 {
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      justify-self: start;
      border-radius: 10px;
      padding: 5px 9px;
      font-size: 14px;
    }
    .servicio__dibujo {
      grid-column: 1;
      grid-row: 1 / 3;
      width: 96px;
      height: 72px;
      padding: 0;
    }
    .servicio p {
      grid-column: 2;
      grid-row: 2;
      align-self: start;
      font-size: 14px;
    }

    .banda {
      gap: 14px;
    }
    .banda h2 {
      font-size: 12px;
    }
    .banda__item {
      width: 190px;
      height: 190px;
      margin-right: 12px;
    }
    .banda__nombre {
      font-size: 12px;
    }

    main {
      padding-bottom: 44px;
    }
    .cierre-marco {
      margin-block: 44px 0;
    }
    .cierre-marco + .seccion {
      padding-top: 32px;
    }
    .cierre {
      padding: 24px 20px;
      border-radius: 22px;
      gap: 8px;
    }
    .cierre__texto {
      gap: 8px;
    }
    .cierre h2 {
      font-size: 26px;
    }
    .cierre p {
      font-size: 16px;
    }
  }
</style>
