---
// Página para direcciones que no existen. Cloudflare Pages la usa
// automáticamente (sin ella, mostraría la portada en cualquier ruta).
import Base from '../layouts/Base.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
import { paginas } from '../data/sitio';
import { enlaceWhatsApp } from '../lib/whatsapp';
---

<Base
  titulo="Página no encontrada · Laboratorio Digital"
  descripcion="Esta página no existe. Elige una de nuestras secciones o escríbenos por WhatsApp."
  tema="claro"
  actual="inicio"
>
  <main class="contenedor no-encontrada">
    <span class="no-encontrada__codigo">404</span>
    <h1>No encontramos esta página.</h1>
    <p>Puede que el enlace esté mal escrito o que la página ya no exista. Elige por dónde seguir:</p>
    <ul>
      <li><a href="/">Inicio</a></li>
      {paginas.map((p) => <li><a href={p.ruta}>{p.nombre}</a></li>)}
    </ul>
    <BotonWhatsApp href={enlaceWhatsApp()} />
  </main>
</Base>

<style>
  .no-encontrada {
    flex: 1 0 auto;
    padding-block: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    text-align: center;
  }
  .no-encontrada__codigo {
    font-size: 16px;
    font-weight: 900;
    letter-spacing: 0.2em;
    color: #0f7a44;
  }
  h1 {
    font-weight: 900;
    font-size: clamp(32px, 4vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  p {
    max-width: 560px;
    font-size: 18px;
    font-weight: 600;
    color: var(--texto-suave);
  }
  ul {
    margin: 8px 0 16px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  ul a {
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--gris);
    color: #141414;
    font-weight: 800;
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  ul a:hover {
    background: #e4e4e0;
  }
</style>
