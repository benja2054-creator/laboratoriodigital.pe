---
// Layout de todas las páginas: <head> con SEO, cabecera y pie compartidos.
// Las fuentes se declaran todas aquí; el navegador solo descarga las que la
// página realmente usa.
import '@fontsource/figtree/500.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/700.css';
import '@fontsource/figtree/800.css';
import '@fontsource/figtree/900.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito/900.css';
import '@fontsource/lilita-one/400.css';
import '../styles/global.css';

import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import AvisoCookies from '../components/AvisoCookies.astro';
import { sitio, type PaginaId } from '../data/sitio';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

interface Props {
  titulo: string;
  descripcion: string;
  tema: 'claro' | 'mazo';
  actual: PaginaId;
  acento?: string; // color del subrayado del menú en la página actual
  // Imagen al compartir el enlace (1200×630, en public/og/, se generan con
  // `npm run og`). Las páginas sin imagen propia usan la de la portada.
  imagenCompartir?: string;
}
const { titulo, descripcion, tema, actual, acento, imagenCompartir = '/og/inicio.jpg' } = Astro.props;

const colorNavegador = tema === 'mazo' ? '#14184A' : '#FFFFFF';
// Con build.format 'file' la ruta llega como "/merch-empresas.html" o
// "/index.html"; Cloudflare las publica sin ".html", así que se quita. La
// página 404 no tiene dirección propia.
const ruta = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonica = Astro.site && ruta !== '/404' ? new URL(ruta, Astro.site).href : undefined;
// "?v=" cambia solo cuando cambia la imagen: así WhatsApp y las redes, que
// guardan la vista previa, descargan la nueva en vez de mostrar la vieja.
const version = createHash('md5').update(readFileSync(`public${imagenCompartir}`)).digest('hex').slice(0, 8);
const imagen = new URL(`${imagenCompartir}?v=${version}`, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content={colorNavegador} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {canonica && <link rel="canonical" href={canonica} />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:site_name" content={sitio.marca} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    {canonica && <meta property="og:url" content={canonica} />}
    <meta property="og:image" content={imagen} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={titulo} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagen} />
  </head>
  <body data-tema={tema} style={acento ? `--acento: ${acento}` : undefined}>
    <Cabecera tema={tema} actual={actual}>
      <slot name="acciones" slot="acciones" />
      <slot name="acciones-movil" slot="acciones-movil" />
    </Cabecera>
    <slot />
    <Pie />
    <AvisoCookies />
  </body>
</html>
