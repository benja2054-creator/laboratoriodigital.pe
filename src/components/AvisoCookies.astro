---
// Aviso de cookies (Ley 29733 y punto 9 de la Política de privacidad).
// Google Analytics NO se carga hasta que el visitante pulsa "Aceptar".
// Si rechaza, no se carga nunca. La decisión se guarda en el navegador y se
// puede cambiar desde "Preferencias de cookies" en el pie de página.
import { googleAnalyticsId } from '../data/sitio';
---

<div class="cookies" role="dialog" aria-modal="false" aria-labelledby="cookies-titulo" aria-describedby="cookies-texto" data-aviso-cookies hidden>
  <div class="cookies__texto">
    <p id="cookies-titulo" class="cookies__titulo">Usamos cookies</p>
    <p id="cookies-texto">
      Las necesarias hacen funcionar el sitio. Con tu permiso, usamos también cookies de analítica (Google Analytics) para
      saber cuántas personas nos visitan y qué páginas les interesan. Si las rechazas, el sitio funciona igual.{' '}
      <a href="/privacidad">Política de privacidad</a>
    </p>
  </div>
  <div class="cookies__botones">
    <button type="button" class="cookies__boton" data-cookies="rechazado">Rechazar</button>
    <button type="button" class="cookies__boton" data-cookies="aceptado">Aceptar</button>
  </div>
</div>

<script is:inline define:vars={{ gaId: googleAnalyticsId }}>
  (() => {
    const CLAVE = 'ld-cookies-analitica';
    const aviso = document.querySelector('[data-aviso-cookies]');
    let cargado = false;

    const leer = () => {
      try {
        return localStorage.getItem(CLAVE);
      } catch {
        return null;
      }
    };
    const guardar = (valor) => {
      try {
        localStorage.setItem(CLAVE, valor);
      } catch {
        /* sin almacenamiento: el aviso volverá a salir en la próxima visita */
      }
    };

    // Carga Google Analytics solo tras el consentimiento.
    const cargarAnalitica = () => {
      if (cargado || !gaId) return;
      cargado = true;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('js', new Date());
      window.gtag('config', gaId);
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(gaId);
      document.head.appendChild(s);
    };

    const mostrar = () => {
      aviso.hidden = false;
      document.documentElement.classList.add('con-aviso-cookies');
    };
    const ocultar = () => {
      aviso.hidden = true;
      document.documentElement.classList.remove('con-aviso-cookies');
    };

    const decision = leer();
    if (decision === 'aceptado') cargarAnalitica();
    else if (decision !== 'rechazado') mostrar();

    aviso.querySelectorAll('[data-cookies]').forEach((boton) =>
      boton.addEventListener('click', () => {
        const valor = boton.dataset.cookies;
        const antes = leer();
        guardar(valor);
        ocultar();
        if (valor === 'aceptado') cargarAnalitica();
        // Si retira un consentimiento ya dado, recargamos para descargar Analytics.
        else if (antes === 'aceptado' && cargado) location.reload();
      }),
    );

    // "Preferencias de cookies" (pie de página) vuelve a abrir el aviso.
    document.addEventListener('click', (e) => {
      if (e.target.closest && e.target.closest('[data-abrir-cookies]')) {
        e.preventDefault();
        mostrar();
        aviso.querySelector('[data-cookies="rechazado"]').focus();
      }
    });
  })();
</script>

<style>
  .cookies {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 200;
    max-width: 880px;
    margin-inline: auto;
    padding: 18px 20px;
    border-radius: 18px;
    background: #141414;
    color: #ffffff;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    gap: 20px;
    font-family: 'Figtree', system-ui, sans-serif;
  }
  .cookies[hidden] {
    display: none;
  }
  .cookies__titulo {
    font-size: 16px;
    font-weight: 900;
    margin-bottom: 4px;
  }
  .cookies__texto p:last-child {
    font-size: 14px;
    font-weight: 500;
    line-height: 1.45;
    color: #d6d6d6;
  }
  .cookies__texto a {
    color: #ffffff;
    font-weight: 700;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .cookies__botones {
    flex-shrink: 0;
    display: flex;
    gap: 10px;
  }
  /* Aceptar y Rechazar con el mismo peso visual: la elección debe ser libre. */
  .cookies__boton {
    min-height: 46px;
    min-width: 116px;
    padding: 0 18px;
    border-radius: 12px;
    border: 2px solid #ffffff;
    background: #ffffff;
    color: #141414;
    font-size: 15px;
    font-weight: 800;
  }
  .cookies__boton:hover {
    background: #e6e6e6;
    border-color: #e6e6e6;
  }
  .cookies__boton:focus-visible {
    outline: 3px solid #ffc21a;
    outline-offset: 3px;
  }

  /* En celular, el aviso queda por encima de las barras fijas de cada página. */
  @media (max-width: 767px) {
    .cookies {
      left: 8px;
      right: 8px;
      bottom: calc(8px + env(safe-area-inset-bottom));
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 16px;
    }
    .cookies__botones .cookies__boton {
      flex: 1;
    }
  }
</style>
